# ===== نسخة الإنتاج: انسخها إلى .env على السيرفر وعدّل القيم المعلّمة بـ <<< =====
APP_NAME="نظام الصيدلية"
APP_ENV=production
APP_KEY=                       # <<< شغّل: php artisan key:generate
APP_DEBUG=false                # لا تجعلها true على السيرفر أبداً
APP_URL=https://example.com    # <<< رابط موقعك
APP_TIMEZONE=Asia/Hebron

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_system         # <<<
DB_USERNAME=erp_user           # <<< مستخدم خاص بالموقع، ليس root
DB_PASSWORD=                   # <<< كلمة سر قوية

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # الموقع يعمل على HTTPS

# ===== البريد (لازم لرسائل «نسيت كلمة المرور») =====
# مع MAIL_MAILER=log الرسالة لا تُرسل بل تُكتب في storage/logs/laravel.log (مناسب للتجربة فقط)
# مثال Gmail: فعّل التحقق بخطوتين ثم أنشئ «App Password» من حساب Google وضعه في MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com       # <<<
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com    # <<<
MAIL_PASSWORD=                 # <<< App Password (16 حرفاً)، ليس كلمة سر الحساب
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=you@gmail.com   # <<<
MAIL_FROM_NAME="${APP_NAME}"

ALLOW_REGISTRATION=false

# كلمة سر حساب المدير عند أول تنصيب (اتركها فارغة لتوليد كلمة عشوائية تُطبع مرة واحدة)
ADMIN_PASSWORD=

BACKUP_KEEP=14
BACKUP_TIME=23:30
ALERTS_TIME=07:30
